<?xml version="1.0" encoding="utf-8"?>
<!--
  Round two of a release: the Inno Setup installer, compiled around the
  executables signed in round one (see exes.xml).

  The file of record is the copy in SignPath's web UI under the project's
  artifact configuration with slug "installer". Change both together.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="SteamlessController-Setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
